{
  "name": "gridiff",
  "displayName": "Gridiff — Visual Table Diff",
  "description": "看清每一个单元格的变化。按主键和字段对齐 CSV、XLSX，可配置工作表读取范围，支持 Mova 多行表头。",
  "version": "0.1.17",
  "publisher": "sunneeyang",
  "repository": {
    "type": "git",
    "url": "https://github.com/SunneeYang/gridiff.git"
  },
  "license": "MIT",
  "private": true,
  "vsce": {
    "readmePath": "README.extension.md"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "csv",
    "diff",
    "table",
    "mova",
    "xlsx"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "gridiff.openDiff",
        "title": "Gridiff: 以表格方式查看当前差异",
        "icon": "$(table)"
      },
      {
        "command": "gridiff.compareFiles",
        "title": "Gridiff: 比较两个文件…"
      },
      {
        "command": "gridiff.selectLeft",
        "title": "Gridiff: 选择为旧版本"
      },
      {
        "command": "gridiff.compareSelected",
        "title": "Gridiff: 与所选旧版本比较"
      },
      {
        "command": "gridiff.compareHead",
        "title": "Gridiff: 与 HEAD 比较",
        "icon": "$(table)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "gridiff.openDiff",
          "when": "isInDiffEditor",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "gridiff.selectLeft",
          "when": "!explorerResourceIsFolder",
          "group": "gridiff@1"
        },
        {
          "command": "gridiff.compareSelected",
          "when": "!explorerResourceIsFolder && gridiff.hasLeft",
          "group": "gridiff@2"
        },
        {
          "command": "gridiff.compareFiles",
          "when": "!explorerResourceIsFolder",
          "group": "gridiff@3"
        },
        {
          "command": "gridiff.compareHead",
          "when": "resourceScheme == file && !explorerResourceIsFolder",
          "group": "gridiff@4"
        }
      ]
    },
    "configuration": {
      "title": "Gridiff",
      "properties": {
        "gridiff.autoOpenDiff": {
          "type": "boolean",
          "default": true,
          "description": "CSV 或 XLSX 差异成为活动标签时自动打开 Gridiff。保留原差异标签；切回原差异或关闭 Gridiff 后，同一标签不会重复自动打开。"
        },
        "gridiff.format": {
          "type": "string",
          "enum": [
            "auto",
            "csv",
            "mova",
            "mova-vertical",
            "headerless",
            "custom"
          ],
          "default": "auto",
          "description": "表头格式，适用于 CSV 和 XLSX 工作表。auto 识别 Mova 四行表头或竖表，否则按一行表头。"
        },
        "gridiff.keyColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "用于记录对齐的字段名，可为复合主键。留空时 Mova 竖表使用 name（名称），其他表使用 id 或第一列。"
        },
        "gridiff.headerRow": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "description": "custom 格式的字段名所在记录（从 1 开始，CSV 引号内换行不另计）。"
        },
        "gridiff.dataStartRow": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "description": "custom 格式的数据起始记录（从 1 开始）。"
        },
        "gridiff.descriptionRow": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "custom 格式的中文说明所在记录，0 表示无。"
        },
        "gridiff.xlsxSheets": {
          "type": "string",
          "enum": [
            "all",
            "first",
            "named"
          ],
          "default": "all",
          "description": "XLSX 读取范围：all 读取全部工作表；first 仅读取首表并按位置配对；named 按 xlsxSheetNames 读取指定工作表。修改后重新读取或重新打开比较。"
        },
        "gridiff.xlsxSheetNames": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": [],
          "description": "xlsxSheets 为 named 时使用的工作表名称列表，区分大小写并精确匹配；支持多张表。仅缺少一侧时显示新增/删除，两侧都找不到时报错。"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:ui": "node test/ui.cjs",
    "check": "node --check src/extension.js && node --check src/csv.js && node --check src/diff.js && node --check src/webview.js && node --check media/main.js && node --check scripts/release.js && node --check src/xlsx.js && node --check src/git.js && node --check src/comparison.js && node --check src/page.js && node --check media/browser.js && node --check scripts/build-cli.js && node --check src/xlsx-core.js && node --check src/xlsx-sheets.js && node --check media/themes.js && node --check scripts/sync-project.js && node --check scripts/benchmark.cjs && node --check media/view.js && node --check src/sheets.js",
    "package": "vsce package -o dist/",
    "release": "node scripts/release.js",
    "build:cli": "node scripts/build-cli.js",
    "test:browser": "node test/browser-ui.cjs",
    "test:binary": "node test/standalone-binary.cjs",
    "test:themes": "node test/themes.cjs",
    "test:go": "cd cli && go test ./...",
    "test:guide": "node test/guide.cjs",
    "sync:project": "node scripts/sync-project.js",
    "benchmark": "node scripts/benchmark.cjs",
    "test:reuse": "node test/browser-reuse.cjs",
    "test:xlsx-snapshot": "node test/xlsx-snapshot.cjs",
    "test:sheets": "node test/sheet-selection.cjs",
    "test:native": "node test/native-parity.cjs"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0",
    "ovsx": "1.3.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "saxes": "6.0.0",
    "ssf": "0.11.2",
    "yauzl": "3.4.0",
    "jszip": "3.10.2"
  }
}
